# Backend
SERVER_PORT=4000
DATABASE_URL=postgres://localhost:5432/studio_spot
# D3: Jest uses this separate database when it's set (createdb studio_spot_test).
# Integration tests wipe it between tests, so never point it at real data.
TEST_DATABASE_URL=postgres://localhost:5432/studio_spot_test

# D1: where Next.js forwards /api/* (see next.config.ts).
API_URL=http://localhost:4000

# D18: email goes to Mailpit locally (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Studio <no-reply@studio.local>"
# Base URL for links in emails.
APP_URL=http://localhost:3000

# D11: `yarn create-admin` and `yarn seed` create this admin.
# DEV ONLY: use your own values anywhere real. The password needs at least 12 characters.
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@studio.local
ADMIN_PASSWORD=change-me-admin-2026
