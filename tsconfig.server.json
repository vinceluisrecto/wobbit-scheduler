{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "jsx": "preserve",
    "rootDir": "src",
    "outDir": "dist",
    "plugins": [],
    "paths": {}
  },
  "include": [
    "src/server.ts",
    "src/create-app.ts",
    "src/config",
    "src/routes",
    "src/controllers",
    "src/services",
    "src/repositories",
    "src/db",
    "src/middlewares",
    "src/validators",
    "src/types",
    "src/utils",
    "src/constants"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
